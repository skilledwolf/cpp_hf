# Figures on the documentation pages. conf.py points MATPLOTLIBRC here, so
# every executed page draws with the same fonts, sizes and colours.
figure.figsize: 6.0, 3.6
figure.dpi: 110
figure.constrained_layout.use: True
font.size: 10
axes.titlesize: 10
axes.labelsize: 10
axes.spines.top: False
axes.spines.right: False
axes.prop_cycle: cycler(color=["0f766e", "6b7280", "b45309", "1d4ed8", "be123c", "7c3aed"])
axes.grid: False
legend.frameon: False
lines.linewidth: 1.6
image.cmap: viridis
savefig.dpi: 110
savefig.bbox: tight
